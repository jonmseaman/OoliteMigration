formulas:
  done_days_ago: if(done_at, ((now() - date(done_at)) / 86400000).round(0), "")
  stale: if(state == "working" && since && (now() - date(since)) / 3600000 > 4, "stale", "")
properties:
  note.status:
    displayName: Status
  note.needs:
    displayName: Needs
  note.worker:
    displayName: Worker
  note.reviewer:
    displayName: Reviewer
  note.branch:
    displayName: Branch
  note.progress:
    displayName: Progress
  note.pr:
    displayName: PR
  note.done_at:
    displayName: Done on
  formula.done_days_ago:
    displayName: Days since done
  formula.stale:
    displayName: Stale?
views:
  - type: kanban
    name: Needs me
    filters:
      and:
        - file.inFolder("tasks")
        - status == "Blocked"
    groupBy:
      property: needs
      direction: ASC
    groupOrder:
      - spec
      - plan
      - tasks
      - review
      - merge
      - decision
      - failure
      - login
      - 
    order:
      - file.name
      - worker
      - branch
      - speckit
  - type: kanban
    name: Status
    filters:
      and:
        - file.inFolder("tasks")
        - or:
            - status != "Done"
            - done_at > now() - "7 days"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - New
      - Ready
      - In Progress
      - Review
      - Blocked
      - Done
      - 
    order:
      - file.name
      - worker
      - progress
      - needs
  - type: kanban
    name: Workers
    filters:
      and:
        - file.inFolder("tasks")
        - status != "Done"
        - status != "New"
    groupBy:
      property: worker
      direction: ASC
    groupOrder:
      - 
      - any
      - win-1
      - win-2
      - ubuntu-1
      - mac-1
    order:
      - file.name
      - status
      - order
      - branch
  - type: kanban
    name: win-1 queue
    filters:
      and:
        - file.inFolder("tasks")
        - worker == "win-1"
        - or:
            - status != "Done"
            - done_at > now() - "7 days"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - Ready
      - In Progress
      - Review
      - Blocked
      - Done
    order:
      - file.name
      - order
      - progress
  - type: kanban
    name: win-2 queue
    filters:
      and:
        - file.inFolder("tasks")
        - worker == "win-2"
        - or:
            - status != "Done"
            - done_at > now() - "7 days"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - Ready
      - In Progress
      - Review
      - Blocked
      - Done
    order:
      - file.name
      - order
      - progress
  - type: kanban
    name: ubuntu-1 queue
    filters:
      and:
        - file.inFolder("tasks")
        - worker == "ubuntu-1"
        - or:
            - status != "Done"
            - done_at > now() - "7 days"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - Ready
      - In Progress
      - Review
      - Blocked
      - Done
    order:
      - file.name
      - order
      - progress
  - type: kanban
    name: mac-1 queue
    filters:
      and:
        - file.inFolder("tasks")
        - worker == "mac-1"
        - or:
            - status != "Done"
            - done_at > now() - "7 days"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - Ready
      - In Progress
      - Review
      - Blocked
      - Done
    order:
      - file.name
      - order
      - progress
  - type: table
    name: Review
    filters:
      and:
        - file.inFolder("tasks")
        - or:
            - status == "Review"
            - and:
                - status == "Blocked"
                - needs == "merge"
    order:
      - file.name
      - status
      - worker
      - reviewer
      - branch
      - pr
  - type: table
    name: All cards
    filters:
      and:
        - file.inFolder("tasks")
        - or:
            - status != "Done"
            - done_at > now() - "7 days"
    order:
      - file.name
      - status
      - needs
      - worker
      - reviewer
      - order
      - repo
      - branch
      - progress
      - requires
      - after
      - pr
      - done_at
  - type: table
    name: Done
    filters:
      and:
        - file.inFolder("tasks")
        - status == "Done"
    order:
      - file.name
      - done_at
      - formula.done_days_ago
      - worker
      - branch
      - pr
  - type: table
    name: Lanes
    filters:
      and:
        - file.inFolder("workers")
    order:
      - file.name
      - machine
      - state
      - formula.stale
      - card
      - step
      - since
      - roles
      - capabilities
      - paused
      - agent_version
      - oar_version
