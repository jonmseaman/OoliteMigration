# Native Windows checkout (ADR-0017): normalise text, keep scripts LF so MSYS2 bash and
# Python run them unchanged. Set core.autocrlf=false and core.longpaths=true on the Windows git.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.plist text eol=lf
*.oolite-save text eol=lf
# Line-oriented data read by shell tooling (read -r doesn't strip \r): must be LF even though
# *.txt in general falls to core.eol (native = CRLF on Windows) via the `* text=auto` default.
tools/deny-list.txt text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.ogg binary
*.dat binary
*.oxz binary
*.zip binary
