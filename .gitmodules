# Submodule layout: ADR-0067 (supersedes ADR-0017's subtree decision).
#
# oolite-dev is the tree being migrated: jonmseaman/oolite, branch develop. Every change to the
# game is a commit there (a bead's on branch bead/<id> inside the submodule) and this repo
# records which commit. oolite-main is the same repository's master, for reference only.
# Everything under upstream/ is OoliteProject's own, unmodified, for reference only.
[submodule "oolite-dev"]
	path = oolite-dev
	url = https://github.com/jonmseaman/oolite.git
	branch = develop
[submodule "oolite-main"]
	path = oolite-main
	url = https://github.com/jonmseaman/oolite.git
	branch = master
[submodule "upstream/oolite"]
	path = upstream/oolite
	url = https://github.com/OoliteProject/oolite.git
	branch = master
[submodule "upstream/oolite-tests"]
	path = upstream/oolite-tests
	url = https://github.com/OoliteProject/oolite-tests.git
	branch = master
[submodule "upstream/oolite-expansion-catalog"]
	path = upstream/oolite-expansion-catalog
	url = https://github.com/OoliteProject/oolite-expansion-catalog.git
	branch = main
[submodule "spidermonkey-ff4"]
	path = upstream/spidermonkey-ff4
	url = https://github.com/OoliteProject/spidermonkey-ff4.git
[submodule "oolite-debug-console"]
	path = upstream/oolite-debug-console
	url = https://github.com/OoliteProject/oolite-debug-console.git
[submodule "oolite-mac-components"]
	path = upstream/oolite-mac-components
	url = https://github.com/OoliteProject/oolite-mac-components.git
