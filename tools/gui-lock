#!/usr/bin/env bash
# The GUI-tier desktop mutex.
#
# The PyAutoGUI tier drives a real window with synthetic OS input events, so it takes the
# interactive desktop exclusively: two GUI tests running at once would steal each other's
# focus and each other's clicks (docs/phases/0-gui-tier.md, "Platform notes"). This is that
# exclusion, and it is deliberately a plain mkdir lock so that a shell script, a pytest run
# and a CI step can all take the same lock without sharing a language.
#
# This script is the SINGLE SOURCE OF TRUTH for the lock path:
# upstream/oolite/tests/gui/conftest.py::_lock_path() shells out to `tools/gui-lock path` and
# only falls back to its own copy of the rules when there is no bash. The path is emitted in
# native `C:/...` form via `cygpath -m`, because handing an MSYS `/c/...` path to a native
# Windows python resolves it to `C:/c/...` (WinError 3) and would lock a different directory.
#
# A lock is OWNED. The owner identity is $OO_GUI_LOCK_OWNER when set, otherwise
# "<host>:<PPID>" - the process that invoked this script, so an `acquire` and a later
# `release` from the same pytest session or the same interactive shell match, while a stray
# shell, or a second session whose acquire timed out but whose teardown still runs, does not.
# `release` REFUSES to drop a lock this owner does not hold. Set OO_GUI_LOCK_OWNER explicitly
# when acquire and release run as separate CI steps with different parent processes.
#
#   tools/gui-lock acquire [--timeout N]   block until held (default 900s), then exit 0
#   tools/gui-lock refresh                 keep a lock THIS owner holds from going stale (exit 3 otherwise)
#   tools/gui-lock release [--force]       drop a lock THIS owner holds (exit 3 otherwise)
#   tools/gui-lock status                  exit 0 if held, 1 if free; prints the holder
#   tools/gui-lock path                    print the lock directory and exit 0
#   tools/gui-lock owner                   print this invocation's owner identity
#   tools/gui-lock run [--timeout N] -- cmd...   acquire, run cmd, release, propagate status
set -u

# Never hand an MSYS /c/... path to a native binary: native python turns it into C:/c/...
# (WinError 3). cygpath -m is that boundary; off MSYS there is no boundary to cross.
normalize_path() {
	if command -v cygpath >/dev/null 2>&1; then
		cygpath -m "$1"
	else
		printf '%s\n' "$1"
	fi
}

lock_dir() {
	local raw
	if [ -n "${OO_GUI_LOCK_DIR:-}" ]; then
		raw="$OO_GUI_LOCK_DIR"
	elif [ -n "${LOCALAPPDATA:-}" ]; then
		raw="$LOCALAPPDATA/Temp/oolite-gui-desktop.lock"
	else
		raw="${TMPDIR:-${TEMP:-/tmp}}/oolite-gui-desktop.lock"
	fi
	normalize_path "$raw"
}

LOCK="$(lock_dir)"
OWNER="$LOCK/owner"

# Who we are, for ownership: the CALLER's pid, not ours. acquire and release are two separate
# invocations made by one longer-lived process (pytest, a CI step, your shell).
owner_id() {
	if [ -n "${OO_GUI_LOCK_OWNER:-}" ]; then
		printf '%s\n' "$OO_GUI_LOCK_OWNER"
	else
		printf '%s:%s\n' "${HOSTNAME:-$(hostname)}" "$PPID"
	fi
}

# The identity recorded in the lock, or empty if there is none to read.
held_by() {
	[ -f "$OWNER" ] || return 0
	sed -n 's/^owner=//p' "$OWNER" 2>/dev/null | head -n 1
}

# A holder that died without releasing would wedge the tier for ever, so a lock older than
# OO_GUI_LOCK_STALE seconds is reclaimed.
#
# THE DEFAULT MUST STAY BELOW THE DEFAULT ACQUIRE TIMEOUT (bug oo-c7bu). It was 1800s while
# acquire()'s default timeout was 900s - TWICE the timeout - so a lock left by a process that
# died could NEVER be reclaimed inside a single acquire: every acquirer waited out its full
# 900s and then failed. Observed in production as '76 passed, 7 errors in 915.35s', every one
# of the seven 'could not take the GUI desktop lock: timed out after 900s; held by
# DESKTOP-DNENHGI:py26916' with BOTH recorded pids already absent from the process table.
# So: any change to this default, or to acquire()'s, must keep STALE < that timeout, and the
# invariant is asserted at startup below rather than left to a comment.
STALE="${OO_GUI_LOCK_STALE:-600}"
# The reap gate (below). Held for a few syscalls only, so its own stale window is short.
REAP="$LOCK.reap"
REAP_STALE="${OO_GUI_LOCK_REAP_STALE:-300}"

dir_age() {
	local now
	now=$(date +%s)
	printf '%s\n' "$(( now - $(stat -c %Y "$1" 2>/dev/null || echo "$now") ))"
}

# --- LIVENESS (bug oo-c7bu) ----------------------------------------------------------------
#
# Age alone is not enough. The production wedge was a lock whose owner was ALREADY GONE from
# the process table: nothing about waiting out a window makes that lock any more abandoned
# than it was one second after the holder died, and the wait is pure fleet time burned. So a
# lock whose owner is DEMONSTRABLY dead is reclaimed with NO age requirement at all.
#
# Three rules keep this from weakening the mutex, and every one of them fails SAFE (to "this
# holder is alive", i.e. to the old age-only behaviour):
#
#   1. HOST-SCOPED. The record carries a hostname. A pid on ANOTHER machine tells us nothing -
#      pid 1234 is very much alive over there and probably alive here too, belonging to someone
#      else entirely. A record whose host is not this host is NEVER judged dead.
#   2. THE LIVENESS PID IS THE *CALLER*, NOT THIS SCRIPT. `info=... pid=$$` is this short-lived
#      bash, which exits seconds after acquire returns - reading THAT as liveness would declare
#      every live lock dead and hand the desktop to everyone at once. The recorded `livepid=`
#      is the long-lived process that owns the hold (the pytest session, the CI step, your
#      shell), derived in live_id() below.
#   3. UNKNOWN IS ALIVE. No livepid= line (a lock written by an older checkout, or the
#      momentary window inside acquire() between mkdir and writing the owner file), an
#      unparseable one, or a process table we could not read at all - all mean "cannot prove
#      dead", and a holder that cannot be proven dead is left strictly alone.
#   4. A FRESH LOCK IS NEVER CONDEMNED BY LIVENESS. A lock younger than OO_GUI_LOCK_LIVENESS_GRACE
#      seconds is judged on AGE ALONE, however dead its recorded pid looks. This closes a hole
#      that the first draft of this fix opened and that tools/gui-lock-selftest check 7 caught
#      immediately: 6 of 8 concurrent trials DOUBLE-ACQUIRED. Two windows produce a
#      briefly-dead-looking pid on a lock that is legitimately held:
#        * acquire() is not instantaneous. Between `mkdir $LOCK` and the write of livepid= a
#          reader sees a lock with no liveness record; a reader that arrives a moment later,
#          while the recorded pid is still being resolved, can see a pid that is not yet (or no
#          longer) in the table it samples.
#        * A hand-off. The winner's owning process may exit moments after acquire returns while
#          its lock is legitimately still being used by the run it belongs to.
#      Waiting a few seconds before trusting liveness costs a reclaim that already replaces a
#      900-second wedge with a sub-minute one. It is the cheapest possible insurance against the
#      one failure mode that matters: two runs on the desktop at once.
#
# This is ADDITIVE to the age rule, never a replacement: an unparseable or foreign-host record
# still ages out on OO_GUI_LOCK_STALE exactly as before.
LIVENESS_GRACE="${OO_GUI_LOCK_LIVENESS_GRACE:-15}"

# The pids whose life proves the hold is live, as "HOST PID [PID...]", or empty when we cannot
# name one. Preference order for the identity, most explicit first:
#   * $OO_GUI_LOCK_OWNER_PID  - a caller that knows which process the hold belongs to says so.
#   * the owner identity itself - "<host>:<pid>", "<host>:py<pid>", "<host>:<tag><pid>": the
#     shape every in-tree caller already writes (conftest.py::_lock_owner, desktop_lock.py).
#   * $PPID - the process that invoked us. EXCLUDING 1: a bash spawned by a native Windows
#     python reports PPID=1 (documented at _lock_owner), and "pid 1" is not an identity.
#
# BOTH PID NAMESPACES ARE RECORDED, and a holder is alive if ANY recorded pid is alive.
# The two halves of this lock count pids differently - $$/$PPID here are MSYS pids, while
# conftest.py's os.getpid() and its CreateToolhelp32Snapshot table are native Windows pids -
# so a single number is unreadable by one half or the other. Worse, the two are not even
# stable together: `bash -c '...; sleep 25'` EXECS the final command, which keeps the MSYS pid
# but gives the process a BRAND-NEW native pid. MEASURED: recording only the native pid made a
# live, sleeping holder read as dead within seconds and an intruder took its lock. Recording
# both and requiring only one to be alive fails safe in exactly the right direction: a pid we
# cannot follow keeps the holder alive, it never condemns it.
live_id() {
	local me="$1" host="${HOSTNAME:-$(hostname)}" pid=""
	if [ -n "${OO_GUI_LOCK_OWNER_PID:-}" ]; then
		printf '%s %s\n' "$host" "$(pid_aliases "$OO_GUI_LOCK_OWNER_PID")"
		return 0
	fi
	case "$me" in
		*:*[0-9])
			# Trailing digit run after the LAST colon, with any tag ("py", "jsapi") between.
			pid="${me##*:}"
			pid="$(printf '%s\n' "$pid" | sed -n 's/.*[^0-9]\([0-9][0-9]*\)$/\1/p; s/^\([0-9][0-9]*\)$/\1/p' | head -n 1)"
			host="${me%%:*}"
			;;
	esac
	if [ -z "$pid" ] && [ "${PPID:-0}" -gt 1 ] 2>/dev/null; then
		pid="$PPID"
	fi
	[ -n "$pid" ] || return 0
	printf '%s %s\n' "$host" "$(pid_aliases "$pid")"
}

# Every name this machine knows one process by: the pid as given, plus the MSYS and native pids
# of whichever `ps -W` row it matches (column 1 is the MSYS pid, column 4 the native one).
# Space separated, deduplicated, and always including the input even when nothing matches.
pid_aliases() {
	local pid="$1" row out
	case "$pid" in ''|*[!0-9]*) printf '%s\n' "$pid"; return 0 ;; esac
	out="$pid"
	if command -v ps >/dev/null 2>&1; then
		row="$(ps -W 2>/dev/null | awk -v p="$pid" 'NR>1 && ($1==p || $4==p) {print $1" "$4; exit}')"
		for cand in $row; do
			case " $out " in *" $cand "*) ;; *) [ -n "$cand" ] && out="$out $cand" ;; esac
		done
	fi
	printf '%s\n' "$out"
}


# The "HOST PID" recorded in the lock, or empty if there is none to read.
live_record() {
	[ -f "$OWNER" ] || return 0
	sed -n 's/^livepid=//p' "$OWNER" 2>/dev/null | head -n 1
}

# Is this pid in the process table? UNKNOWN COUNTS AS ALIVE (rule 3).
#
# On MSYS `ps -W` is the only reader that sees BOTH worlds: column 1 is the MSYS pid and column
# 4 the native Windows pid, and the identities we are handed come from both ($PPID is an MSYS
# pid; conftest's os.getpid() is a native one). Matching either column can only ever produce a
# FALSE ALIVE on a coincidental collision, which costs one age-out - never a false dead, which
# would cost the mutex.
proc_alive() {
	local pid="$1" table
	case "$pid" in ''|*[!0-9]*) return 0 ;; esac
	if command -v ps >/dev/null 2>&1; then
		table="$(ps -W 2>/dev/null || ps 2>/dev/null)" || return 0
		[ -n "$table" ] || return 0   # unreadable table: cannot prove dead
		printf '%s\n' "$table" | awk -v p="$pid" 'NR>1 && ($1==p || $4==p){f=1} END{exit f?0:1}'
		return $?
	fi
	kill -0 "$pid" 2>/dev/null && return 0
	return 1
}

# Can we PROVE the current holder is gone? Only then is age skipped. A holder is alive if ANY
# of its recorded pids is alive - see live_id() on why there is more than one.
owner_is_dead() {
	local rec host pids p
	rec="$(live_record)"
	[ -n "$rec" ] || return 1                       # no record: not provably dead
	host="${rec%% *}"; pids="${rec#* }"
	[ -n "$host" ] && [ -n "$pids" ] && [ "$pids" != "$rec" ] || return 1
	[ "$host" = "${HOSTNAME:-$(hostname)}" ] || return 1   # another machine's pid proves nothing
	for p in $pids; do
		proc_alive "$p" && return 1
	done
	return 0
}

# Reclaiming a stale lock must be ATOMIC WITH TAKING IT, or it is not a mutex.
#
# The obvious "if stale: rm -rf; then mkdir" is a TOCTOU: two runs can both judge the SAME
# directory stale, and the loser's rm -rf then deletes the WINNER'S freshly created lock -
# after which the loser's own mkdir succeeds and BOTH runs drive the desktop. (Reproduced at
# ~1 trial in 3.) It is worse than a lost wakeup, because the loser also destroys the winner's
# owner record, so the winner's later release is refused while it is still on the desktop.
#
# So: serialise reapers behind a second, short-lived mkdir lock ($LOCK.reap), RE-CHECK the age
# inside that gate, and do not drop the gate until we hold the new $LOCK. A late reaper that
# arrives after someone else reclaimed sees a fresh mtime and reaps nothing. The stale
# directory is retired with `mv` (one atomic rename, one winner) rather than rm -rf, so no
# other process can observe a half-emptied lock.
#
# Chosen over "rename the stale dir and proceed only if the rename won" on its own, because a
# bare rename is still a TOCTOU against the *fresh* lock: a slow loser that decided "stale"
# before the winner's mkdir would rename away a live, legitimately held lock. The gate plus
# the re-check inside it is what closes that window.
#
# THE LIVENESS RULE RIDES THE SAME GATE (bug oo-c7bu). "Reclaimable" is now "aged out OR the
# owner is provably dead", and that predicate is evaluated in exactly the two places the age
# test was: once cheaply outside the gate, and once again INSIDE it, re-reading the owner file
# from disk. That re-read is what keeps the window closed: a late reaper that arrives after
# someone else reclaimed reads the NEW owner record - fresh mtime, a live pid - and reaps
# nothing. Skipping the age never skips the gate, the re-check, or the atomic rename.
#
# Returns 0 ONLY if this process both retired the stale lock and now holds a new empty $LOCK.

# The single predicate: is the lock at $LOCK reclaimable right now, and why? Echoes a reason.
reclaimable() {
	local age="$1"
	# Liveness may only condemn a lock that has had time to settle (rule 4).
	if [ "$age" -ge "$LIVENESS_GRACE" ] 2>/dev/null && owner_is_dead; then
		printf 'owner %s is gone from the process table (lock %ss old)\n' "$(held_by)" "$age"
		return 0
	fi
	if [ "$age" -gt "$STALE" ]; then
		printf 'stale: %ss old (> %ss), held by %s\n' "$age" "$STALE" "$(held_by)"
		return 0
	fi
	return 1
}

reclaim_stale() {
	[ -d "$LOCK" ] || return 1
	# Cheap unsynchronised pre-check, so the common (held by a live run) poll stays cheap.
	reclaimable "$(dir_age "$LOCK")" >/dev/null || return 1
	if ! mkdir "$REAP" 2>/dev/null; then
		# A reaper crashed mid-reclaim? Retire the gate itself atomically - whoever wins the
		# rename does NOT assume it holds the gate, it just lets the next loop re-mkdir it.
		if [ "$(dir_age "$REAP")" -gt "$REAP_STALE" ]; then
			local dead_gate="$REAP.dead.$$.${RANDOM:-0}"
			mv "$REAP" "$dead_gate" 2>/dev/null && rm -rf "$dead_gate"
		fi
		return 1
	fi
	local rc=1 why dead
	if [ -d "$LOCK" ]; then
		# RE-CHECK inside the gate, re-reading the owner record: the holder we judged dead a
		# moment ago may since have been replaced by a live one that legitimately owns this.
		if why="$(reclaimable "$(dir_age "$LOCK")")"; then
			echo "gui-lock: reclaiming lock ($why)" >&2
			dead="$LOCK.stale.$$.${RANDOM:-0}"
			if mv "$LOCK" "$dead" 2>/dev/null; then
				rm -rf "$dead"
				mkdir "$LOCK" 2>/dev/null && rc=0
			fi
		fi
	else
		# Someone reclaimed and released while we waited for the gate: the lock is simply free.
		mkdir "$LOCK" 2>/dev/null && rc=0
	fi
	rmdir "$REAP" 2>/dev/null || rm -rf "$REAP"
	return $rc
}

acquire() {
	local timeout="${1:-900}" deadline me live
	me="$(owner_id)"
	live="$(live_id "$me")"
	deadline=$(( $(date +%s) + timeout ))
	mkdir -p "$(dirname "$LOCK")"
	while :; do
		if mkdir "$LOCK" 2>/dev/null || reclaim_stale; then
			{
				printf 'owner=%s\n' "$me"
				printf 'info=%s pid=%s %s\n' "${HOSTNAME:-$(hostname)}" "$$" "$(date -Is)"
				# The liveness record (bug oo-c7bu). "HOST PID" of the LONG-LIVED caller, never
				# of this script - see live_id(). Written LAST, so a reader that catches the
				# file half-written sees no livepid= and falls back to age, which is safe.
				[ -n "$live" ] && printf 'livepid=%s\n' "$live"
			} >"$OWNER"
			printf '%s\n' "$LOCK"
			return 0
		fi
		if [ "$(date +%s)" -ge "$deadline" ]; then
			echo "gui-lock: timed out after ${timeout}s; held by $(held_by)" >&2
			# NAME THE MISCONFIGURATION THAT CAUSED THE PRODUCTION WEDGE (bug oo-c7bu). A stale
			# window at or above the acquire timeout means an aged-out reclaim can never fire
			# inside one acquire: the acquirer waits out its whole timeout and fails, which is
			# how seven GUI tests burned 915s against a lock whose owner was already dead.
			# Liveness normally reclaims such a lock instantly and with no age at all, so
			# reaching here with that ratio means liveness could not judge the holder (a
			# foreign host, or a record with no livepid=) AND age was unreachable. Diagnosed on
			# the failure path rather than refused up front, so a deliberately tiny window in a
			# test is never blocked - only an acquire that has already failed is explained.
			if [ "$STALE" -ge "$timeout" ] 2>/dev/null; then
				echo "gui-lock: OO_GUI_LOCK_STALE=${STALE}s is not less than the acquire timeout ${timeout}s, so an abandoned lock could not be reclaimed within this acquire (oo-c7bu); set OO_GUI_LOCK_STALE below the timeout" >&2
			fi
			return 1
		fi
		sleep 2
	done
}

# ONLY THE OWNER MAY RELEASE. Dropping a lock another run is actively holding puts two
# processes on the interactive desktop at once, which is the exact collision this lock exists
# to prevent, so a non-owner release is an error (exit 3), not a no-op.
release() {
	local force="${1:-}" me holder
	[ -d "$LOCK" ] || return 0
	me="$(owner_id)"
	holder="$(held_by)"
	if [ "$force" = "--force" ]; then
		echo "gui-lock: force-releasing lock held by ${holder:-unknown} (we are $me)" >&2
		rm -rf "$LOCK"
		return 0
	fi
	if [ -z "$holder" ]; then
		echo "gui-lock: refusing to release $LOCK: no owner recorded; wait for the stale reap or pass --force" >&2
		return 3
	fi
	if [ "$holder" != "$me" ]; then
		echo "gui-lock: refusing to release a lock we do not own (held by $holder, we are $me)" >&2
		return 3
	fi
	rm -rf "$LOCK"
}

# A LIVE holder must be able to keep its lock alive past OO_GUI_LOCK_STALE without defeating the
# stale mechanism (bug oo-ccy9). The stale window exists for holders that DIED; a holder that is
# still on the desktop must not be reclaimed out from under itself. The JS-API snapshot holds the
# desktop for a whole enumeration - up to MAX_SESSION_RESTARTS=80 sessions at OO_READY_TIMEOUT
# seconds each - which can exceed the 1800s default, at which point a second game would legally
# land on the desktop while the first is still being driven.
#
# `refresh` is therefore the ONLY way to extend a hold, and it is deliberately:
#   * OWNERSHIP-CHECKED, exactly like release - one run may not keep another run's lock alive;
#   * A PUSH from the live holder, not a property of the lock. It touches the directory's mtime,
#     which is precisely what dir_age() reads. Nothing about the lock itself is made immortal.
# So crash-safety is preserved by construction: the refreshes stop when the holder stops, the
# mtime ages from the LAST refresh, and the lock goes stale OO_GUI_LOCK_STALE seconds later and is
# reclaimable as before. A dead holder cannot heartbeat.
#
# Both the lock dir and the owner file are touched: dir_age() stats the directory, but writing the
# owner file is what updates the directory mtime on some filesystems, so we do not rely on either
# one alone.
refresh() {
	local me holder live
	[ -d "$LOCK" ] || {
		echo "gui-lock: refusing to refresh $LOCK: it is not held" >&2
		return 3
	}
	me="$(owner_id)"
	holder="$(held_by)"
	if [ "$holder" != "$me" ]; then
		echo "gui-lock: refusing to refresh a lock we do not own (held by ${holder:-none}, we are $me)" >&2
		return 3
	fi
	# Re-assert the liveness record too (bug oo-c7bu), so a hold whose long-lived pid changed
	# between acquire and now - or one taken by a checkout that did not write livepid= - is
	# re-pinned to a process that is demonstrably running RIGHT NOW: this one. A refresh is
	# already ownership-checked, so this cannot be used to claim someone else's hold.
	live="$(live_id "$me")"
	if [ -n "$live" ] && [ "$live" != "$(live_record)" ]; then
		{ grep -v '^livepid=' "$OWNER" 2>/dev/null; printf 'livepid=%s\n' "$live"; } >"$OWNER.tmp.$$" \
			&& mv "$OWNER.tmp.$$" "$OWNER" 2>/dev/null || rm -f "$OWNER.tmp.$$"
	fi
	touch "$OWNER" "$LOCK" 2>/dev/null || return 1
}

status() {
	if [ -d "$LOCK" ]; then
		echo "held: $(held_by) $(sed -n 's/^info=//p' "$OWNER" 2>/dev/null | head -n 1)"
		return 0
	fi
	echo "free"
	return 1
}

timeout=900
force=""
cmd="${1:-}"
[ $# -gt 0 ] && shift
while [ $# -gt 0 ]; do
	case "$1" in
		--timeout) timeout="$2"; shift 2 ;;
		--force) force="--force"; shift ;;
		--) shift; break ;;
		*) break ;;
	esac
done

case "$cmd" in
	acquire) acquire "$timeout" ;;
	refresh) refresh ;;
	release) release "$force" ;;
	status)  status ;;
	path)    printf '%s\n' "$LOCK" ;;
	owner)   owner_id ;;
	run)
		acquire "$timeout" >/dev/null || exit 1
		"$@"
		rc=$?
		release
		exit $rc
		;;
	*)
		echo "usage: tools/gui-lock {acquire|refresh|release|status|path|owner|run -- cmd...} [--timeout N] [--force]" >&2
		exit 2
		;;
esac
