#!/usr/bin/env bash
#
# Proof that tools/guardrails.sh FAILS on a real violation of each of its four rules, and
# passes on the legitimate changes that look like one (bead oo-ptc). A check that cannot fail is
# not a check; a check that fails on legitimate work gets bypassed, so every violation case here
# is paired with a NEGATIVE CONTROL.
#
#     tools/guardrails-selftest            # all cases, exit 0 only if every one behaves
#
# NOTHING HERE TOUCHES THIS REPOSITORY. Every case is applied to a throwaway fixture git repo
# built from scratch in a PRIVATE `mktemp -d` under the system temp directory (see SCRATCH
# below: $TMPDIR, else $TEMP, else %LOCALAPPDATA%\Temp, else /tmp), removed by an EXIT trap:
# that is the only honest way to prove the goldens guard, since proving it in place would mean
# committing the exact edit the guard exists to forbid, and the same for the deleted-test guard.
#
# The fixture is a MINIATURE of the real tree (two protected golden paths, a .feature, a step
# library, two .m sources, a meson.build) rather than a clone, so a case runs in milliseconds
# and the scenario under test is the only thing in the diff. The two files that carry the real
# policy - tools/guardrails.sh and tools/deny-list.txt - are COPIED IN, not reimplemented, so
# this exercises the shipping guard and the shipping pattern list.
#
# THE FIXTURE IS DELIBERATELY DIRTY. OOJSEngine.m carries three JS_* call sites and OOCocoa.m
# carries a pre-existing `#pragma GCC diagnostic ignored`, exactly as the real upstream tree
# does, because the most damaging defect this guard ever had was a PURE RENAME of such a file
# reading as "the whole file was added". A fixture of clean files cannot catch that.
set -u

cd "$(dirname "$0")/.." || exit 1
REPO="$PWD"
GUARD="$REPO/tools/guardrails.sh"
DENY="$REPO/tools/deny-list.txt"

# CONCURRENCY. accept.sh runs this script as an acceptance line, and the fleet runs several
# workers and their reviewers in parallel BY DESIGN, so two invocations overlap routinely. A
# FIXED scratch path made that fatal: the `rm -rf` below and the per-fixture `rm -rf` in
# fixture() would delete an in-flight run's tree - including the directory it was cd'd into -
# and the victim reported ANTI-VACUITY failures ("the test-file classifier matches 0 tracked
# files", "tools/deny-list.txt is missing") because its own cwd had vanished. That is a
# SPURIOUS RED on a correct tree, which is worse than no gate at all: it teaches agents to
# re-run until green. Each run therefore gets its own private mktemp -d, removed by an EXIT
# trap (also on INT/TERM, so an interrupted run does not leak a tree either). No fixed path:
# post-mortem debuggability is not worth a flaky merge gate - set SELFTEST_KEEP=1 to keep the
# tree, and the path is printed on failure.
TMPROOT="${TMPDIR:-${TEMP:-${LOCALAPPDATA:+$LOCALAPPDATA/Temp}}}"
TMPROOT="${TMPROOT:-/tmp}"
SCRATCH="$(mktemp -d "$TMPROOT/oolite-guardrails-selftest.XXXXXX")" || exit 1
cleanup() { [ -n "${SELFTEST_KEEP:-}" ] || { cd / 2>/dev/null; rm -rf "$SCRATCH"; }; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

fail=0
cases=0
ok() { cases=$((cases+1)); printf 'PASS: %s\n' "$1"; }
no() { cases=$((cases+1)); printf 'FAIL: %s\n' "$1"; fail=1; }

# Built by concatenation so the forbidden literals never appear in this file's own source.
FLAG="-W""no-unused-variable"
PRAGMA="#pragma GCC diag""nostic ignored \"-W""unused-variable\""
PRAGMA_CLANG="#pragma clang diag""nostic ignored \"-W""shadow\""
ATTR="__attr""ibute__((unused))"
UPRAGMA="_Prag""ma"

git_c() { git -c user.email=s@l -c user.name=s "$@"; }

# The fixture POPULATES goldens/, which the real tree does not yet, so the shipped guard's
# PROTECTED_PREFIXES_PENDING exemption for goldens/ would be stale in every fixture and emit a
# "that exemption is stale" note on all ~60 cases. The fixture copy therefore drops that one
# exemption line; case 1k reinstates the pristine guard to prove the exemption itself works.
install_guard_into() { grep -v '^goldens/|not populated yet' "$GUARD" > "$1"; }

# fixture <name> : a fresh repo on branch main with one clean commit; cd's into it
# $SCRATCH is private to THIS run (mktemp -d above), so this rm -rf can never reach another
# run's identically-named fixture - the second of the two destruction mechanisms that made
# overlapping runs fail.
fixture() {
  local d="$SCRATCH/$1"
  rm -rf "$d"; mkdir -p "$d/tools" "$d/goldens" "$d/tests/golden/scenarios/001" \
    "$d/upstream/oolite/tests/component/features" "$d/upstream/oolite/tests/component/steps" \
    "$d/upstream/oolite/src/Core" "$d/.github/workflows"
  # See install_guard()'s comment: the fixture populates goldens/, so the shipped
  # PROTECTED_PREFIXES_PENDING exemption for it would be stale here. Case 1k uses the pristine
  # guard to prove the exemption mechanism itself.
  install_guard_into "$d/tools/guardrails.sh"
  cp "$DENY"  "$d/tools/deny-list.txt"
  printf '{ "settle_seconds": 8 }\n' > "$d/tests/golden/scenarios/001/scenario.json"
  printf 'golden one\n' > "$d/goldens/g1.txt"
  printf 'golden two\n' > "$d/goldens/g2.txt"
  cat > "$d/upstream/oolite/tests/component/features/s1.feature" <<'EOF'
Feature: Ship-to-ship combat
  Scenario: A police viper engages a lone pirate
    Given a clean system
    When the viper engages
    Then the pirate is destroyed
EOF
  cat > "$d/upstream/oolite/tests/component/steps/world_steps.py" <<'EOF'
from pytest_bdd import given, when, then

@given("a clean system")
def clean_system():
    universe.reset()

@when("the viper engages")
def engage():
    universe.tick()

@then("the pirate is destroyed")
def destroyed():
    assert universe.pirate is None
EOF
  cat > "$d/upstream/oolite/src/Core/OOColor.m" <<'EOF'
#import "OOColor.h"

@implementation OOColor
- (void) reset { _r = 0.0f; }
@end
EOF
  # Carries deny-listed symbols already, like 102 real files do.
  cat > "$d/upstream/oolite/src/Core/OOJSEngine.m" <<'EOF'
#import "OOJSEngine.h"

static JSRuntime *sRuntime;

void OOJSInit(void)
{
    sRuntime = JS_NewRuntime(8L * 1024L * 1024L);
    JS_SetErrorReporter(sRuntime, OOJSReport);
}
EOF
  # Carries a pre-existing suppression, like four real upstream files do.
  { printf '#import "OOCocoa.h"\n'
    printf '%s\n' "$PRAGMA"
    printf 'static int gLegacy;\n'; } > "$d/upstream/oolite/src/Core/OOCocoa.m"
  printf "project('oolite', 'c')\n" > "$d/upstream/oolite/src/Core/meson.build"
  printf 'name: build\njobs:\n  linux:\n    runs-on: ubuntu-latest\n' > "$d/.github/workflows/ci.yml"
  ( cd "$d" && git init -q -b main . && git_c add -A && git_c commit -qm base ) || return 1
  cd "$d" || return 1
}

# run the guard in the current fixture; prints rc and captures output in $OUT
run_guard() { OUT=$(bash tools/guardrails.sh 2>&1); RC=$?; }

# expect_fail <case> <substring>
expect_fail() {
  run_guard
  printf '  rc=%s\n' "$RC"
  printf '%s\n' "$OUT" | grep -E 'guardrails: (goldens|suppression|tests|deny-list):' | sed 's/^/    /'
  if [ "$RC" -eq 0 ]; then no "$1 (guard exited 0 on a real violation)"; return; fi
  if printf '%s' "$OUT" | grep -qF "$2"; then ok "$1"; else no "$1 (failed, but not with \"$2\")"; fi
}

expect_pass() {
  run_guard
  printf '  rc=%s\n' "$RC"
  if [ "$RC" -eq 0 ]; then ok "$1"; else printf '%s\n' "$OUT" | sed 's/^/    /'; no "$1 (guard exited $RC on a clean tree)"; fi
}

echo "=== 0. clean fixture: the guard must PASS, or every case below is meaningless ==="
fixture clean || { no "fixture setup"; exit 1; }
expect_pass "clean tree passes (with pre-existing pragma and JS_* sites present)"

# =================================================================================================
echo
echo "=== 1. goldens: a change under a protected golden path is REFUSED ==="
fixture goldens || exit 1
printf '{ "settle_seconds": 99 }\n' > tests/golden/scenarios/001/scenario.json
expect_fail "modified golden is refused" "has no re-bless approval"

echo
echo "=== 1b. ...and a NEW file dropped under a protected path is refused too ==="
fixture goldens_add || exit 1
mkdir -p tests/golden/scenarios/002 && printf '{}\n' > tests/golden/scenarios/002/scenario.json
expect_fail "added golden is refused" "has no re-bless approval"

echo
echo "=== 1c. ...unless a re-bless approval is already on record (a PRIOR commit) ==="
fixture goldens_ok || exit 1
printf 'tests/golden/scenarios/001/scenario.json  Jon, weekly re-bless queue\n' > tools/rebless-approvals.txt
git_c add -A >/dev/null; git_c commit -qm "approval" >/dev/null
# main is the checked-out branch, so that commit already moved the base: the approval is part
# of the BASE, not of the change under test. That is the whole point of this case.
printf '{ "settle_seconds": 99 }\n' > tests/golden/scenarios/001/scenario.json
expect_pass "approved re-bless is allowed"

echo
echo "=== 1d. ...and a change may NOT approve itself in the same breath ==="
fixture goldens_self || exit 1
printf 'tests/golden/scenarios/001/scenario.json  I approve of me\n' > tools/rebless-approvals.txt
printf '{ "settle_seconds": 99 }\n' > tests/golden/scenarios/001/scenario.json
expect_fail "self-approval refused" "may not approve itself"

echo
echo "=== 1e. ...a golden DELETED is refused (the case that always worked) ==="
fixture goldens_del || exit 1
git rm -q goldens/g1.txt
expect_fail "deleted golden refused" "has no re-bless approval"

echo
echo "=== 1f. FINDING 2: a golden RENAMED OUT of a protected path is refused ==="
# Was rc=0/OK: changed_paths() printed only the NEW side, so the guard was shown an ordinary
# unprotected path and never learned a golden had left Jon's custody. goldens/ has no
# is_test_path() backstop, so nothing else caught it either. g2.txt stays behind, so the
# anti-vacuity assertion still passes and this case is about the rename and nothing else.
fixture goldens_rename_out || exit 1
git mv goldens/g1.txt upstream/oolite/src/Core/g1_backup.txt
expect_fail "golden renamed OUT of goldens/ refused" "is RENAMED OUT of a protected golden path"

echo
echo "=== 1g. ...including out of tests/golden/scenarios/ ==="
fixture goldens_rename_out2 || exit 1
git mv tests/golden/scenarios/001/scenario.json upstream/oolite/src/Core/old_scenario.json
expect_fail "scenario golden renamed out refused" "is RENAMED OUT of a protected golden path"

echo
echo "=== 1h. ...and a rename WITHIN the protected path is still a change to a golden ==="
fixture goldens_rename_in || exit 1
git mv goldens/g1.txt goldens/g1-renamed.txt
expect_fail "golden renamed within goldens/ refused" "inside a protected golden path"

echo
echo "=== 1i. ...and dropping a file INTO a protected path is refused ==="
fixture goldens_rename_into || exit 1
git mv upstream/oolite/src/Core/OOColor.m goldens/OOColor.m.bak
expect_fail "file renamed into goldens/ refused" "is renamed into a protected golden path"

echo
echo "=== 1j. NEGATIVE CONTROL: renaming an ordinary file near, but not in, a golden path ==="
fixture goldens_neg || exit 1
git mv upstream/oolite/src/Core/OOColor.m upstream/oolite/src/Core/OOColour.m
expect_pass "ordinary rename outside protected paths passes"

# The exemption these two cases exercise no longer exists in the real guard (goldens/ is
# populated, so the line was deleted as stale). They must therefore INJECT their own pending
# exemption into the copied guard rather than depend on the shipped list still carrying one -
# otherwise the cases silently stop testing the pending mechanism the day it is emptied.
inject_pending() {  # inject_pending <prefix> ; edits ./tools/guardrails.sh in the fixture
  python3 - "$1" <<'PY'
import re, sys
p = sys.argv[1]
f = 'tools/guardrails.sh'
s = open(f, encoding='utf-8').read()
new = 'PROTECTED_PREFIXES_PENDING="\n%s|selftest fixture: exercising the pending-exemption path\n"' % p
s2, n = re.subn(r'PROTECTED_PREFIXES_PENDING="\n(.*?)"', new.replace('\\', '\\\\'), s, count=1, flags=re.S)
assert n == 1, 'PROTECTED_PREFIXES_PENDING not found in guard - selftest fixture cannot inject'
open(f, 'w', encoding='utf-8', newline='\n').write(s2)
PY
}

echo
echo "=== 1k. FINDING 7: anti-vacuity is PER-PREFIX, not any-of ==="
# Was: seen=1 if ANY prefix was tracked, so with goldens/ empty in the real tree (0 files) and
# tests/golden/scenarios/ holding 1, the goldens/ half was ALREADY VACUOUS and the assertion
# passed regardless. Now each prefix must exist or be explicitly, documentedly exempt.
fixture vac_one_prefix || exit 1
cp "$GUARD" tools/guardrails.sh          # the real guard...
inject_pending 'goldens/'                # ...plus a fixture exemption for goldens/
git rm -q -r goldens >/dev/null
git_c commit -qam "guard with fixture exemption, no goldens" >/dev/null
printf '// unrelated\n' >> upstream/oolite/src/Core/OOColor.m
expect_pass "the documented-pending prefix may be empty"

fixture vac_other_prefix || exit 1
git rm -q -r tests/golden >/dev/null
expect_fail "an UNEXEMPTED empty protected prefix fails the run" "the protected-path list has rotted"

echo
echo "=== 1k2. ...and a PENDING exemption that has gone stale is called out ==="
# The exemption is a dated promise, not a permanent hole: once the prefix is populated the line
# must go, and the guard says so rather than quietly carrying a lie.
fixture vac_stale_exempt || exit 1
cp "$GUARD" tools/guardrails.sh          # real guard + fixture exemption, but goldens/ IS populated
inject_pending 'goldens/'
git_c commit -qam "guard with fixture exemption" >/dev/null
printf '// unrelated\n' >> upstream/oolite/src/Core/OOColor.m
run_guard
printf '  rc=%s\n' "$RC"
if [ "$RC" -eq 0 ] && printf '%s' "$OUT" | grep -qF "that exemption is stale"; then
  ok "a stale pending-prefix exemption is reported (and does not fail the run)"
else
  no "a stale pending-prefix exemption is reported (rc=$RC)"
fi

echo
echo "=== 1l. FINDING 7 (lesser): an INDENTED approval line does not approve ==="
# awk 'NF{print $1}' stripped leading whitespace, so a line indented to look like part of the
# file's example block approved for real. Approvals must start in column one.
fixture approve_indent || exit 1
printf '   tests/golden/scenarios/001/scenario.json  hiding in the example block\n' > tools/rebless-approvals.txt
git_c add -A >/dev/null; git_c commit -qm "sneaky approval" >/dev/null
printf '{ "settle_seconds": 99 }\n' > tests/golden/scenarios/001/scenario.json
expect_fail "indented approval does not approve" "has no re-bless approval"

echo
echo "=== 1m. NEGATIVE CONTROL: the same approval, flush left, still works ==="
fixture approve_flush || exit 1
printf 'tests/golden/scenarios/001/scenario.json  Jon, flush left, real approval\n' > tools/rebless-approvals.txt
git_c add -A >/dev/null; git_c commit -qm "real approval" >/dev/null
printf '{ "settle_seconds": 99 }\n' > tests/golden/scenarios/001/scenario.json
expect_pass "flush-left approval approves"

# =================================================================================================
echo
echo "=== 2. suppression: a NEW warning suppression is REFUSED ==="
fixture sup_flag || exit 1
printf "extra_args = ['%s']\n" "$FLAG" >> upstream/oolite/src/Core/meson.build
expect_fail "added compiler flag refused" "adds a warning suppression"

fixture sup_pragma || exit 1
printf '%s\n' "$PRAGMA_CLANG" >> upstream/oolite/src/Core/OOColor.m
expect_fail "added pragma refused" "adds a warning suppression"

fixture sup_attr || exit 1
printf 'static int leftover %s;\n' "$ATTR" >> upstream/oolite/src/Core/OOColor.m
expect_fail "added unused-attribute refused" "adds a warning suppression"

echo
echo "=== 2b. ...but a suppression that was ALREADY there is not a new violation ==="
fixture sup_preexisting || exit 1
printf '// an unrelated later edit\n' >> upstream/oolite/src/Core/OOCocoa.m
expect_pass "pre-existing suppression does not fail a later edit"

echo
echo "=== 2c. ...and prose ABOUT the rule is not a violation (the grep trap) ==="
fixture sup_prose || exit 1
{ printf '# House rules\n'
  printf 'Never add %s or a %s to silence a warning.\n' "$FLAG" "$PRAGMA"; } > NOTES.md
expect_pass "documentation quoting the forbidden constructs passes"

echo
echo "=== 2d. FINDING 5: the _Pragma() string form is matched ==="
# _Pragma is the ONLY way to put a diagnostic suppression inside a macro, so it is the natural
# spelling in a port - and it matched NEITHER the guard's pattern set NOR the deny-list copy,
# so both of the two checks that "ask different questions" were blind to it.
fixture sup_uPragma || exit 1
{ printf '#define QUIET_BEGIN %s("GCC diag' "$UPRAGMA"; printf 'nostic push") \\\n'
  printf '                    %s("GCC diag' "$UPRAGMA"; printf 'nostic ignored \\"-W'; printf 'unused-variable\\")\n'
  printf 'QUIET_BEGIN\nstatic int quiet;\n'; } >> upstream/oolite/src/Core/OOColor.m
expect_fail "_Pragma diagnostic suppression refused" "adds a warning suppression"

echo
echo "=== 2e. ...and the DENY-LIST copy of the patterns catches it too ==="
# The deny-list is per-file and baseline-relative, which is a different question; it must not
# have the same hole. Proven by putting the construct in a file the suppression check exempts.
fixture sup_uPragma_deny || exit 1
{ printf '%s("GCC diag' "$UPRAGMA"; printf 'nostic ignored \\"-W'; printf 'shadow\\")\n'; } >> upstream/oolite/src/Core/OOJSEngine.m
run_guard
printf '  rc=%s\n' "$RC"
if printf '%s' "$OUT" | grep -qF "reintroduces deny-listed symbols"; then ok "_Pragma is also a deny-list hit"; else no "_Pragma is also a deny-list hit (deny-list did not fire)"; fi

echo
echo "=== 2f. NEGATIVE CONTROL: an ordinary _Pragma that is not a diagnostic passes ==="
fixture sup_uPragma_neg || exit 1
{ printf '%s("pack(push, 1)")\n' "$UPRAGMA"; } >> upstream/oolite/src/Core/OOColor.m
expect_pass "_Pragma(\"pack\") is not a suppression"

echo
echo "=== 2g. FINDING 6: build systems that actually carry the flags are scanned ==="
# CODE_RE covered meson/Makefile/GNUmakefile/.mk but not the places this tree really builds
# from. Each of these was rc=0/OK before.
fixture sup_cmake || exit 1
printf 'add_compile_options(%s)\n' "$FLAG" > CMakeLists.txt
expect_fail "CMakeLists.txt suppression refused" "adds a warning suppression"

fixture sup_automake || exit 1
printf 'AM_CFLAGS = -W''no-shadow\n' > Makefile.am
expect_fail "Makefile.am suppression refused" "adds a warning suppression"

fixture sup_autoconf || exit 1
printf 'CFLAGS="$CFLAGS -W''no-error"\n' > configure.ac
expect_fail "configure.ac suppression refused" "adds a warning suppression"

fixture sup_ci || exit 1
printf '    env:\n      CFLAGS: %s\n' "$FLAG" >> .github/workflows/ci.yml
expect_fail "CI workflow yml suppression refused" "adds a warning suppression"

fixture sup_xcconfig || exit 1
printf 'OTHER_CFLAGS = $(inherited) %s\n' "$FLAG" > Build.xcconfig
expect_fail ".xcconfig suppression refused" "adds a warning suppression"

fixture sup_mesonopts || exit 1
printf "option('extra', type: 'string', value: '%s')\n" "$FLAG" > upstream/oolite/meson.options
expect_fail "meson.options suppression refused" "adds a warning suppression"

echo
echo "=== 2h. NEGATIVE CONTROL: yaml/CI prose and ordinary build edits still PASS ==="
# Adding .yml/.yaml to CODE_RE only stays safe because ONLY ADDED LINES are scanned and .md/.txt
# stay out of CODE_RE. Both halves of that argument get a case.
fixture sup_yaml_neg || exit 1
printf '    steps:\n      - run: meson setup build\n' >> .github/workflows/ci.yml
expect_pass "an ordinary CI workflow edit passes"

fixture sup_yaml_pre || exit 1
printf '    env:\n      CFLAGS: %s\n' "$FLAG" >> .github/workflows/ci.yml
git_c commit -qam "pre-existing upstream CI flag" >/dev/null
printf '      - run: ninja -C build\n' >> .github/workflows/ci.yml
expect_pass "a pre-existing CI flag does not fail a later workflow edit"

fixture sup_md_neg || exit 1
printf 'The CI file may not contain %s.\n' "$FLAG" > docs.md
expect_pass "markdown quoting a flag is still out of scope"

echo
echo "=== 2i. FINDING 1 (suppression half): a PURE RENAME of a file that already had a pragma ==="
# THE MOST DAMAGING DEFECT. The new path does not exist at the base, so the baseline was empty,
# so the ENTIRE file read as added and its pre-existing pragma fired the guard. This migration
# renames files by design; the first Phase-1/2 move turned the guard permanently red.
fixture rename_pragma || exit 1
git mv upstream/oolite/src/Core/OOCocoa.m upstream/oolite/src/Core/OOPlatform.m
expect_pass "pure rename of a file carrying a pre-existing pragma passes"

echo
echo "=== 2j. ...and a rename that ALSO adds a suppression is still refused ==="
# The fix must not be "ignore renames": a rename is a normal place to sneak a line in.
fixture rename_pragma_bad || exit 1
git mv upstream/oolite/src/Core/OOColor.m upstream/oolite/src/Core/OOColour.m
printf '%s\n' "$PRAGMA_CLANG" >> upstream/oolite/src/Core/OOColour.m
expect_fail "rename that adds a suppression is refused" "adds a warning suppression"

# =================================================================================================
echo
echo "=== 3. tests: a deleted test file is REFUSED ==="
fixture test_del || exit 1
git rm -q upstream/oolite/tests/component/features/s1.feature
expect_fail "deleted .feature refused" "is deleted"

echo
echo "=== 3b. ...the component step library counts as a test (ADR-0018 §5) ==="
fixture test_steps || exit 1
git rm -q upstream/oolite/tests/component/steps/world_steps.py
expect_fail "deleted step library refused" "is deleted"

echo
echo "=== 3c. ...an EMPTIED test is refused even though the file still exists ==="
fixture test_gut || exit 1
cat > upstream/oolite/tests/component/features/s1.feature <<'EOF'
Feature: Ship-to-ship combat
EOF
expect_fail "gutted .feature refused" "is emptied"

echo
echo "=== 3d. ...as is commenting the assertions out of a step file ==="
fixture test_comment || exit 1
sed -i 's/^@then/#@then/; s/^    assert /    #assert /' upstream/oolite/tests/component/steps/world_steps.py
expect_fail "commented-out steps refused" "is emptied"

echo
echo "=== 3e. ...a test renamed OUT of the test set is refused ==="
fixture test_rename || exit 1
git mv upstream/oolite/tests/component/steps/world_steps.py upstream/oolite/src/Core/world_steps.py
expect_fail "test renamed out of the test set refused" "out of the test set"

echo
echo "=== 3f. ...but ADDING to a test is expected and must PASS ==="
fixture test_add || exit 1
cat >> upstream/oolite/tests/component/features/s1.feature <<'EOF'

  Scenario: A second viper joins
    Given a clean system
    Then the pirate is destroyed
EOF
expect_pass "adding a scenario passes"

fixture test_add_step || exit 1
cat >> upstream/oolite/tests/component/steps/world_steps.py <<'EOF'

@then("the wreckage remains")
def wreckage():
    assert universe.wreckage
EOF
expect_pass "adding a step passes"

echo
echo "=== 3g. FINDING 3: a test renamed to a NON-COLLECTED name INSIDE tests/ is refused ==="
# The R-branch only fired when the new path stopped matching is_test_path(), and is_test_path()
# says yes to anything under tests/ - so disabling a test in place was free. pytest-bdd collects
# neither of these, and every scenario using those steps silently dies.
fixture test_rename_disabled_py || exit 1
git mv upstream/oolite/tests/component/steps/world_steps.py \
       upstream/oolite/tests/component/steps/world_steps_disabled.py.bak
expect_fail "step library renamed to a .bak inside tests/ refused" "nothing collects the new name"

fixture test_rename_disabled_feature || exit 1
git mv upstream/oolite/tests/component/features/s1.feature \
       upstream/oolite/tests/component/features/s1.feature.disabled
expect_fail ".feature renamed to .disabled inside tests/ refused" "nothing collects the new name"

echo
echo "=== 3h. NEGATIVE CONTROL: a legitimate test rename that STAYS collectable passes ==="
fixture test_rename_ok || exit 1
git mv upstream/oolite/tests/component/features/s1.feature \
       upstream/oolite/tests/component/features/combat.feature
expect_pass "renaming a .feature to another .feature passes"

fixture test_rename_ok_steps || exit 1
git mv upstream/oolite/tests/component/steps/world_steps.py \
       upstream/oolite/tests/component/steps/universe_steps.py
expect_pass "renaming a step library within steps/ passes"

echo
echo "=== 3i. ...but a rename that also guts the file is refused ==="
# The rename must still be DETECTED as a rename (so this exercises the R-branch's unit
# comparison, not the D+A fallback): the file keeps its shape and the real scenario is disabled
# with a @skip tag while padding is appended - the same gutting style as 3l, plus a move.
fixture test_rename_and_gut || exit 1
