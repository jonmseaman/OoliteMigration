#!/usr/bin/env bash
# Guard shim for `git`. First on PATH via .claude/settings.json.
#
# Work reaches develop through a pull request you merge, never through an agent's push
# (CLAUDE.md hard rule 5). A bead's branch does have to reach the fork, though: that is what
# `git town propose` pushes before opening the pull request. So a push is allowed only when:
#   - the target repository's origin is the game fork (…/oolite.git), never this planning repo; and
#   - no refspec writes master, main or develop — those move only by merging a pull request; and
#   - it is not a bare --force (a lease-checked force is how `git town sync` rebases a branch).
# Everything that is not a push passes through untouched.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
p="$(echo "$PATH" | tr ':' '\n' | grep -vx "$here" | paste -sd: -)"
real="$(PATH="$p" command -v git || true)"
[ -n "$real" ] || { echo "guard: real git not found on PATH" >&2; exit 127; }

# Find the subcommand, and the -C directory if one was given, skipping option arguments.
sub=""; dir=""; skip=0; want_dir=0
for a in "$@"; do
  if [ "$skip" -eq 1 ]; then
    [ "$want_dir" -eq 1 ] && { dir="$a"; want_dir=0; }
    skip=0; continue
  fi
  case "$a" in
    -C) skip=1; want_dir=1; continue;;
    -c|--git-dir|--work-tree|--namespace|--exec-path|--config-env) skip=1; continue;;
    -*) continue;;
    *) sub="$a"; break;;
  esac
done

if [ "$sub" = "push" ]; then
  refuse() { echo "guard: refusing 'git push' — $1 (CLAUDE.md hard rule 5)." >&2; exit 77; }

  origin="$(cd "${dir:-.}" 2>/dev/null && PATH="$p" "$real" remote get-url origin 2>/dev/null || true)"
  case "$origin" in
    *[/:]oolite.git|*[/:]oolite) : ;;
    *) refuse "origin '${origin:-unknown}' is not the game fork; this planning repo is never pushed by an agent";;
  esac

  protected="$(cd "${dir:-.}" 2>/dev/null && PATH="$p" "$real" config --get git-town.main-branch 2>/dev/null || true)"
  seen_sub=0
  for a in "$@"; do
    if [ "$seen_sub" -eq 0 ]; then [ "$a" = "push" ] && seen_sub=1; continue; fi
    case "$a" in
      --force|-f) refuse "a bare --force discards whatever is on the remote; git town uses --force-with-lease";;
      -*) continue;;
      *:*) dst="${a##*:}";;
      *)   dst="$a";;
    esac
    case "${dst#refs/heads/}" in
      master|main|"${protected:-develop}")
        refuse "'$a' writes $dst directly; that branch moves only when you merge a pull request";;
    esac
  done
fi

PATH="$p" exec "$real" "$@"
