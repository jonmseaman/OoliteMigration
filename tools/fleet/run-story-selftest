#!/usr/bin/env bash
# tools/fleet/run-story-selftest — proof that the frontier driver does what it claims, WITHOUT
# invoking a real model and WITHOUT touching a real bead.
#
# Everything runs inside a throwaway git repo under $TMPDIR. The beads-worker scripts that mutate
# shared state (next-bead.sh, context.sh, accept.sh) are replaced through run-story's documented
# seams by recording stubs; worktree.sh and harvest.sh are the REAL scripts, exercised against the
# scratch repo with a fake `bd` on PATH. The model is played by BEADS_FRONTIER_CMD.
#
# It proves, in order:
#   1  happy path: claim -> worktree -> prompt -> model -> accept -> cleanup
#   2  the prompt carries the bead body AND CLAUDE.md, and the argv carries --model/--disallowedTools
#   3  memorylessness: story 2 shares no temp dir, no worktree and no prompt text with story 1
#   4  the guard REFUSES `bd close`
#   5  the guard REFUSES a bead status mutation (`bd update --status`)
#   6  the guard REFUSES `git push`
#   7  a story that writes under goldens/ is REFUSED and accept is NEVER called
#   8  an accept rejection leaves the worktree in place and exits 6
# Every refusal's verbatim stderr is printed.
set -uo pipefail

SRC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
command -v cygpath >/dev/null 2>&1 && SRC_ROOT="$(cygpath -m "$SRC_ROOT")"
PASS=0; FAIL=0
ok()   { PASS=$((PASS+1)); echo "  PASS: $*"; }
bad()  { FAIL=$((FAIL+1)); echo "  FAIL: $*"; }
check(){ if [ "$1" = "$2" ]; then ok "$3 ($1)"; else bad "$3: expected '$2', got '$1'"; fi; }

ROOT="$(mktemp -d "${TMPDIR:-/tmp}/run-story-selftest.XXXXXX")"
command -v cygpath >/dev/null 2>&1 && ROOT="$(cygpath -m "$ROOT")"
trap 'git -C "$SANDBOX" worktree prune >/dev/null 2>&1; rm -rf "$ROOT"' EXIT
SANDBOX="$ROOT/repo"; REC="$ROOT/rec"
# BIN must be an MSYS-style path: it goes on PATH, and every PATH filter in this tree splits on
# ':', which would tear a "C:/..." entry in half and silently leave the real binary reachable.
BIN="$(command -v cygpath >/dev/null 2>&1 && cygpath -u "$ROOT" || echo "$ROOT")/bin"
mkdir -p "$SANDBOX" "$BIN" "$REC"

# ---- scratch repo ------------------------------------------------------------------------------
mkdir -p "$SANDBOX/tools/fleet" "$SANDBOX/docs/infra" "$SANDBOX/goldens" \
         "$SANDBOX/.agents/skills/beads-worker/scripts"
cp -r "$SRC_ROOT/tools/fleet/." "$SANDBOX/tools/fleet/"
cp "$SRC_ROOT/CLAUDE.md" "$SANDBOX/CLAUDE.md"
cp "$SRC_ROOT/docs/infra/0-machines.md" "$SANDBOX/docs/infra/0-machines.md"
for s in _lib.sh worktree.sh harvest.sh; do
  cp "$SRC_ROOT/.agents/skills/beads-worker/scripts/$s" "$SANDBOX/.agents/skills/beads-worker/scripts/$s"
done
echo "golden data - must never be written by a story" > "$SANDBOX/goldens/keep.txt"
chmod +x "$SANDBOX/tools/fleet/run-story" "$SANDBOX/tools/fleet/guard/"* 2>/dev/null
git -C "$SANDBOX" init -q -b main
git -C "$SANDBOX" -c user.name=t -c user.email=t@t add -A >/dev/null
git -C "$SANDBOX" -c user.name=t -c user.email=t@t commit -qm init
git -C "$SANDBOX" config user.name t; git -C "$SANDBOX" config user.email t@t

# ---- fake bd: never the real one, so no real bead can be touched --------------------------------
cat > "$BIN/bd" <<'EOF'
#!/usr/bin/env bash
echo "fake-bd $*" >> "$REC/bd.calls"
case "${1:-}" in
  show) echo '[{"id":"'"${2:-x}"'","title":"scratch","description":"scratch","notes":"","acceptance_criteria":"true"}]';;
  list) echo '[]';;
esac
exit 0
EOF
chmod +x "$BIN/bd"
export REC
# STRIP THE REPOSITORY'S OWN bd GUARD SHIM. Without this the negative tests are VACUOUS: that shim
# also refuses `bd close` with 77, so tests 4/5 pass while tools/fleet/guard/bd does nothing.
# MEASURED: with the shim still on PATH, deleting run-story's own close refusal gave 36/36 green.
PATH="$(echo "$PATH" | tr ':' '
' | grep -v 'beads-worker/scripts/bin' | paste -sd: -)"
export PATH="$BIN:$PATH"
# Positive control for the instrument itself: the fake bd must be what the stories reach, and it
# must NOT refuse `bd close` - otherwise a refusal proves nothing about tools/fleet/guard/bd.
[ "$(command -v bd)" = "$BIN/bd" ] || { echo "SELFTEST ABORT: 'bd' resolves to $(command -v bd), not the fake at $BIN/bd; the negative tests would be vacuous"; exit 1; }
bd close probe >/dev/null 2>&1 || { echo "SELFTEST ABORT: the fake bd itself refuses 'bd close'; a refusal must come from tools/fleet/guard/bd alone"; exit 1; }

# ---- seam stubs ---------------------------------------------------------------------------------
mk_next() { # $1=id $2=body-marker
  cat > "$ROOT/next-bead-$1.sh" <<EOF
#!/usr/bin/env bash
echo "next-bead \$*" >> "$REC/next.calls"
jq -nc '{id:"$1",title:"scratch story $1",body:"## Task\n$2\n",acceptance:"true",notes:"",labels:["frontier"]}'
EOF
  chmod +x "$ROOT/next-bead-$1.sh"; echo "$ROOT/next-bead-$1.sh"
}
cat > "$ROOT/context.sh" <<'EOF'
#!/usr/bin/env bash
echo "(scratch context for $1)"
EOF
cat > "$ROOT/accept-ok.sh" <<EOF
#!/usr/bin/env bash
echo "accept \$1" >> "$REC/accept.calls"
echo "stub-accept: would close \$1 (never calls bd close)"
exit 0
EOF
cat > "$ROOT/accept-reject.sh" <<EOF
#!/usr/bin/env bash
echo "accept \$1" >> "$REC/accept.calls"
echo "stub-accept: rejected \$1" >&2
exit 1
EOF
chmod +x "$ROOT/context.sh" "$ROOT/accept-ok.sh" "$ROOT/accept-reject.sh"

run_story() { # $1=id $2=body-marker $3=frontier-cmd $4=accept-script ; extra env via RS_ENV
  local id="$1" marker="$2" fcmd="$3" acc="$4"
  ( cd "$SANDBOX" && \
    BEADS_NEXT_BEAD_CMD="$(mk_next "$id" "$marker")" \
    BEADS_CONTEXT_CMD="$ROOT/context.sh" \
    BEADS_ACCEPT_CMD="$acc" \
    BEADS_FRONTIER_CMD="$fcmd" \
    bash tools/fleet/run-story --phase 0 ) 2>&1 </dev/null
  # </dev/null is REQUIRED, not cosmetic: without it the child inherits THIS SCRIPT'S stdin (the
  # script file itself); a child that reads stdin eats bytes bash has not parsed yet, and bash
  # resumes mid-line with a syntax error pointing at an innocent later line.
}

echo "== 1/8 happy path: claim -> worktree -> prompt -> model -> accept -> cleanup"
: > "$REC/accept.calls"
OUT="$(run_story s1 MARKER-STORY-ONE \
  'cp "$STORY_PROMPT_FILE" '"$ROOT"'/prompt1.md; cp "$STORY_ARGV_FILE" '"$ROOT"'/argv1.txt; echo "$PWD" > '"$ROOT"'/cwd1.txt; echo "$STORY_PROMPT_FILE" > '"$ROOT"'/tmp1.txt; echo hello > story1.txt; git add -A; git commit -qm "bead s1: work"; echo model-ran' \
  "$ROOT/accept-ok.sh")"; RC=$?
echo "$OUT" | sed 's/^/    /'
check "$RC" 0 "run-story exits 0 on the happy path"
grep -q 'model-ran' <<<"$OUT" && ok "the model seam ran" || bad "the model seam did not run"
grep -qx 'accept s1' "$REC/accept.calls" && ok "accept.sh was invoked for s1" || bad "accept was never invoked"
[ ! -d "$SANDBOX/.worktrees/s1" ] && ok "worktree cleaned up" || bad "worktree .worktrees/s1 survived cleanup"

echo "== 2/8 prompt and argv construction"
P1="$ROOT/prompt1.md"
grep -q 'MARKER-STORY-ONE' "$P1" && ok "prompt contains the bead body" || bad "prompt is missing the bead body"
grep -q 'Never modify anything under' "$P1" && ok "prompt contains CLAUDE.md (hard rules in scope)" \
  || bad "prompt does not contain CLAUDE.md: the agent contract was not in scope"
grep -q 'scratch context for s1' "$P1" && ok "prompt contains the bead context block" || bad "prompt is missing context.sh output"
A1="$ROOT/argv1.txt"
grep -qx -- '-p' "$A1" && grep -qx -- '--model' "$A1" && grep -qx 'claude-opus-5' "$A1" \
  && ok "argv is 'claude -p --model claude-opus-5'" || bad "argv does not carry -p --model claude-opus-5"
for d in 'Bash(bd close:*)' 'Bash(bd update:*--status*)' 'Bash(git push:*)' 'Write(goldens/**)' 'Edit(goldens/**)'; do
  grep -qxF "$d" "$A1" && ok "argv denies $d" || bad "argv does not deny $d"
done
grep -qE -- '--resume|--continue|--session-id' "$A1" && bad "argv carries a session-resume flag: stories would not be memoryless" \
  || ok "argv carries no --resume/--continue/--session-id"

echo "== 3/8 memorylessness: a second story inherits nothing"
OUT2="$(run_story s2 MARKER-STORY-TWO \
  'cp "$STORY_PROMPT_FILE" '"$ROOT"'/prompt2.md; echo "$STORY_PROMPT_FILE" > '"$ROOT"'/tmp2.txt; ls '"$SANDBOX"'/.worktrees > '"$ROOT"'/wt2.txt; echo x > story2.txt; git add -A; git commit -qm "bead s2: work"' \
  "$ROOT/accept-ok.sh")"; RC2=$?
check "$RC2" 0 "second story exits 0"
T1="$(cat "$ROOT/tmp1.txt")"; T2="$(cat "$ROOT/tmp2.txt")"
[ "$T1" != "$T2" ] && ok "story 2 got a FRESH temp dir ($T1 != $T2)" || bad "story 2 reused story 1's temp dir: $T1"
[ ! -e "$T1" ] && ok "story 1's temp dir was destroyed" || bad "story 1's temp dir $T1 still exists"
grep -q 'MARKER-STORY-TWO' "$ROOT/prompt2.md" && ok "story 2's prompt is its own body" || bad "story 2 prompt missing its body"
grep -q 'MARKER-STORY-ONE' "$ROOT/prompt2.md" && bad "story 2's prompt carries story 1's body: prompts are not memoryless" \
  || ok "story 2's prompt carries NO story-1 context"
grep -q '^s1$' "$ROOT/wt2.txt" && bad "story 1's worktree was still present while story 2 ran" \
  || ok "no leftover worktree from story 1 while story 2 ran"
[ ! -d "$SANDBOX/.worktrees/s2" ] && ok "story 2's worktree cleaned up" || bad "worktree .worktrees/s2 survived"

echo "== 4/8 NEGATIVE: the guard refuses 'bd close'"
OUT="$(run_story n1 X 'set +e; err=$(bd close '"'"'n1'"'"' 2>&1 >/dev/null); rc=$?; echo "GUARD_RC=$rc"; echo "GUARD_ERR=$err"; [ "$rc" -eq 77 ] || { echo "ENFORCEMENT ABSENT: bd close was not refused"; exit 1; }; git commit -q --allow-empty -m "bead n1: work"' "$ROOT/accept-ok.sh")"; RC=$?
echo "$OUT" | sed 's/^/    /'
check "$RC" 0 "the story survives because the guard refused, not because it succeeded"
grep -q 'GUARD_RC=77' <<<"$OUT" && ok "'bd close' refused with rc=77" || bad "'bd close' was NOT refused"
grep -q 'refusing .bd close' <<<"$OUT" && ok "refusal names 'bd close'" || bad "refusal message does not name bd close"

echo "== 5/8 NEGATIVE: the guard refuses a bead status mutation"
OUT="$(run_story n2 X 'set +e; err=$(bd update n2 --status closed 2>&1 >/dev/null); rc=$?; echo "GUARD_RC=$rc"; echo "GUARD_ERR=$err"; err2=$(bd update n2 --status open 2>&1 >/dev/null); rc2=$?; echo "GUARD_RC2=$rc2"; echo "GUARD_ERR2=$err2"; { [ "$rc" -eq 77 ] && [ "$rc2" -eq 77 ]; } || { echo "ENFORCEMENT ABSENT: a status mutation was allowed"; exit 1; }; git commit -q --allow-empty -m "bead n2: work"' "$ROOT/accept-ok.sh")"; RC=$?
echo "$OUT" | sed 's/^/    /'
check "$RC" 0 "status-mutation story ends cleanly after two refusals"
grep -q 'GUARD_RC=77' <<<"$OUT"  && ok "'bd update --status closed' refused (77)" || bad "--status closed was NOT refused"
grep -q 'GUARD_RC2=77' <<<"$OUT" && ok "'bd update --status open' refused (77): ANY status mutation, not just closed" \
  || bad "--status open was NOT refused: the guard only blocks 'closed'"

echo "== 6/8 NEGATIVE: the guard refuses 'git push'"
OUT="$(run_story n3 X 'set +e; err=$(git push origin HEAD 2>&1 >/dev/null); rc=$?; echo "GUARD_RC=$rc"; echo "GUARD_ERR=$err"; err2=$(git -C . push 2>&1 >/dev/null); rc2=$?; echo "GUARD_RC2=$rc2"; { [ "$rc" -eq 77 ] && [ "$rc2" -eq 77 ]; } || { echo "ENFORCEMENT ABSENT: git push was allowed"; exit 1; }; command git commit -q --allow-empty -m "bead n3: work"' "$ROOT/accept-ok.sh")"; RC=$?
echo "$OUT" | sed 's/^/    /'
check "$RC" 0 "git-push story ends cleanly after the refusals"
grep -q 'GUARD_RC=77' <<<"$OUT"  && ok "'git push origin HEAD' refused (77)" || bad "git push was NOT refused"
grep -q 'GUARD_RC2=77' <<<"$OUT" && ok "'git -C . push' refused too (the flag form is not a bypass)" \
  || bad "'git -C . push' slipped past the guard"

echo "== 7/8 NEGATIVE: a story that writes under goldens/ is refused and accept is NEVER called"
: > "$REC/accept.calls"
OUT="$(run_story n4 X 'echo tampered >> goldens/keep.txt; git add -A; git commit -qm "bead n4: touched goldens"' "$ROOT/accept-ok.sh")"; RC=$?
echo "$OUT" | sed 's/^/    /'
check "$RC" 4 "run-story exits 4 (refused) when the story touched goldens/"
grep -q 'touched goldens/' <<<"$OUT" && ok "refusal names goldens/" || bad "refusal does not name goldens/"
[ ! -s "$REC/accept.calls" ] && ok "accept was NEVER called for the goldens-touching story" \
  || bad "accept was called despite a goldens/ violation: $(cat "$REC/accept.calls")"
grep -q 'tampered' "$SANDBOX/goldens/keep.txt" && bad "the pristine checkout's goldens were modified (should only be the worktree copy)" \
  || ok "the base checkout's goldens/keep.txt is untouched"
"$SANDBOX/.agents/skills/beads-worker/scripts/worktree.sh" --remove n4 >/dev/null 2>&1

echo "== 8/8 an accept rejection keeps the worktree and exits 6"
OUT="$(run_story n5 X 'git commit -q --allow-empty -m "bead n5: work"' "$ROOT/accept-reject.sh")"; RC=$?
echo "$OUT" | sed 's/^/    /'
check "$RC" 6 "run-story exits 6 when accept rejects"
[ -d "$SANDBOX/.worktrees/n5" ] && ok "the rejected story's worktree was KEPT for the next round" \
  || bad "the worktree was removed after a rejection: the next round has nothing to resume"
"$SANDBOX/.agents/skills/beads-worker/scripts/worktree.sh" --remove n5 >/dev/null 2>&1

echo
echo "run-story-selftest: $PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ] || exit 1
exit 0
