#!/usr/bin/env bash
#
# tools/merge-queue-selftest -- proof that tools/merge-queue.sh does what it claims, driven end to
# end against SYNTHETIC throwaway git repositories under $LOCALAPPDATA/Temp.
#
# WHY SYNTHETIC. The real gate is tools/tier-c.sh at ~1327 s per invocation. The scenarios below
# make 60+ gate invocations between them; against the real gate that is 22 hours, and it would
# merge real branches into the real main. Against a stubbed gate whose whole contract is an exit
# status it is a couple of seconds, it touches nothing outside the temp directory, and it exercises
# EXACTLY the code paths a real batch would: the same merges, the same bisection, the same
# fast-forward, the same refusals.
#
#   bash tools/merge-queue-selftest            # every scenario
#   bash tools/merge-queue-selftest --list     # names only
#   bash tools/merge-queue-selftest S5         # one scenario
#
# Each scenario asserts POSITIVE EVIDENCE, never merely rc: the number of gate invocations, the
# base SHA before and after, which branches were merged and which evicted, and the verdict string.

set -u -o pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MQ="$HERE/merge-queue.sh"
[ -f "$MQ" ] || { echo "selftest: tools/merge-queue.sh is missing" >&2; exit 2; }

# $LOCALAPPDATA arrives from Windows with BACKSLASHES; bash would create one directory whose name
# literally contains them, and every path built on it then misses silently. Convert it once.
_LA="${LOCALAPPDATA:-}"
if [ -n "$_LA" ] && command -v cygpath >/dev/null 2>&1; then _LA="$(cygpath -u "$_LA")"; fi
TMPROOT="${_LA:-/tmp}/Temp/oo-pmg-selftest.$$"
mkdir -p "$TMPROOT" || { echo "selftest: cannot create $TMPROOT" >&2; exit 2; }
trap 'rm -rf "$TMPROOT" 2>/dev/null || true' EXIT

PASS=0; FAIL=0; FAILED_NAMES=""
ok()   { PASS=$((PASS+1)); printf '    ok   %s\n' "$*"; }
bad()  { FAIL=$((FAIL+1)); FAILED_NAMES="$FAILED_NAMES $CURRENT"; printf '    FAIL %s\n' "$*" >&2; }
eq()   { if [ "$2" = "$3" ]; then ok "$1 = $2"; else bad "$1: expected '$3', got '$2'"; fi; }
has()  { if printf '%s\n' "$2" | grep -q -- "$3"; then ok "$1 contains '$3'"; else bad "$1: output does not contain '$3'"; fi; }
hasnt(){ if printf '%s\n' "$2" | grep -q -- "$3"; then bad "$1: output unexpectedly contains '$3'"; else ok "$1 lacks '$3'"; fi; }

# ------------------------------------------------------------------------------------------------
# A synthetic repository.
#
#   mkrepo <dir> <spec...>   spec = name:kind,  kind in good | bad | inta | intb
#
# main holds a README. Every branch adds exactly one file, so branches never conflict with each
# other by accident -- a conflict in these scenarios would be a bug in the fixture, not a finding.
# The STUB GATE is red when the checked-out tree contains any bad-*.txt, or contains BOTH
# int-a.txt and int-b.txt (the interaction: either alone is green).
# ------------------------------------------------------------------------------------------------

mkrepo() {
  local dir="$1"; shift
  mkdir -p "$dir"; git -C "$dir" init -q -b main
  git -C "$dir" config user.email mq@selftest; git -C "$dir" config user.name "mq selftest"
  printf 'synthetic\n' > "$dir/README"
  git -C "$dir" add README; git -C "$dir" commit -qm base

  cat > "$dir/gate.sh" <<'GATE'
#!/usr/bin/env bash
# The STUB GATE. Its whole contract is the exit status, which is also the whole contract
# tools/tier-c.sh presents to the queue -- that is why substituting it proves the queue.
n=0
if [ -n "${GATE_TALLY:-}" ]; then n=$(( $(cat "$GATE_TALLY" 2>/dev/null || echo 0) + 1 )); printf '%s\n' "$n" > "$GATE_TALLY"; fi
if [ -n "${GATE_FLAKE_AT:-}" ] && [ "$n" = "$GATE_FLAKE_AT" ]; then echo "gate: FLAKY red on invocation $n"; exit 1; fi
if ls bad-*.txt >/dev/null 2>&1; then echo "gate: red, bad file present"; exit 1; fi
if [ -f int-a.txt ] && [ -f int-b.txt ]; then echo "gate: red, int-a and int-b together"; exit 1; fi
echo "gate: green ($(ls | wc -l) entries)"
exit 0
GATE
  git -C "$dir" add gate.sh; git -C "$dir" commit -qm gate

  local s name kind
  for s in "$@"; do
    name="${s%%:*}"; kind="${s##*:}"
    git -C "$dir" checkout -q -b "$name" main
    printf '%s\n' "$name" > "$dir/$name.txt"
    case "$kind" in
      bad)  printf 'boom\n' > "$dir/bad-$name.txt" ;;
      inta) printf 'a\n'    > "$dir/int-a.txt" ;;
      intb) printf 'b\n'    > "$dir/int-b.txt" ;;
    esac
    git -C "$dir" add -A; git -C "$dir" commit -qm "$name ($kind)"
    git -C "$dir" checkout -q main
  done
}

# Attest every named branch at its current tip SHA, without running Tier B (there is no Oolite
# tree here). Scenario S4 proves the attestation is actually REQUIRED.
attest() {
  local dir="$1"; shift
  mkdir -p "$dir/.mq/attest"
  local b sha
  for b in "$@"; do
    sha="$(git -C "$dir" rev-parse "$b")"
    printf 'tier-b green %s %s selftest\n' "$b" "$sha" > "$dir/.mq/attest/$sha"
  done
}

runq() { # runq <dir> <args...> ; sets OUT, RC, RUNS
  local dir="$1"; shift
  printf '0\n' > "$dir/.tally"   # a NUMBER, so "never ran" reads as 0 and not as an empty string
  OUT="$( cd "$dir" && GATE_TALLY="$dir/.tally" GATE_FLAKE_AT="${FLAKE_AT:-}" \
          bash "$MQ" --repo "$dir" --gate "bash $dir/gate.sh" "$@" 2>&1 )"
  RC=$?
  RUNS="$(cat "$dir/.tally" 2>/dev/null || echo 0)"
}

CURRENT=""
scenario() { CURRENT="$1"; SELECTED_COUNT=$((SELECTED_COUNT+1)); printf '\n== %s: %s\n' "$1" "$2"; }

# want <name> -- run this scenario? No arguments means every scenario; otherwise the requested
# subset, so the stored acceptance block can split ~6 minutes of proof across several lines that
# each finish in under a minute.
want() { case " ${WANT:-} " in "  ") return 0 ;; *" $1 "*) return 0 ;; *) return 1 ;; esac; }

WANT=""
[ "${1:-}" = "--list" ] && { grep -oE '^  *scenario S[0-9]+ ".*' "$0" | sed 's/^ *scenario //'; exit 0; }
[ $# -gt 0 ] && WANT="$*"

SELECTED_COUNT=0

# ================================================================================================
# S1  A fully green batch fast-forwards, in ONE gate invocation, and the base SHA really moves.
# ================================================================================================
if want S1; then
  scenario S1 "green batch of 4 fast-forwards in 1 gate run"
  D="$TMPROOT/s1"; mkrepo "$D" f1:good f2:good f3:good f4:good; attest "$D" f1 f2 f3 f4
  BEFORE="$(git -C "$D" rev-parse main)"
  runq "$D" --branches f1,f2,f3,f4
  AFTER="$(git -C "$D" rev-parse main)"
  eq "rc" "$RC" 0
  eq "gate invocations" "$RUNS" 1
  has "output" "$OUT" "FAST-FORWARD main"
  has "output" "$OUT" "verdict          green"
  if [ "$BEFORE" != "$AFTER" ]; then ok "base MOVED $BEFORE -> $AFTER"; else bad "base did not move"; fi
  if git -C "$D" merge-base --is-ancestor "$BEFORE" "$AFTER"; then ok "it was a real fast-forward (old tip is an ancestor)"; else bad "not a fast-forward"; fi
  for b in f1 f2 f3 f4; do
    if git -C "$D" merge-base --is-ancestor "$b" main; then ok "$b is now in main"; else bad "$b is NOT in main"; fi
  done
fi

# ================================================================================================
# S2  --dry-run is INERT: zero gate invocations, no ref moved.  (G8)
# ================================================================================================
if want S2; then
  scenario S2 "--dry-run invokes no gate and moves no ref"
  D="$TMPROOT/s2"; mkrepo "$D" f1:good f2:bad; attest "$D" f1 f2
  BEFORE="$(git -C "$D" rev-parse main)"
  runq "$D" --branches f1,f2 --dry-run
  eq "rc" "$RC" 0
  eq "gate invocations" "$RUNS" 0
  eq "base unmoved" "$(git -C "$D" rev-parse main)" "$BEFORE"
  has "output" "$OUT" "DRY RUN: no gate invoked"
fi

# ================================================================================================
# S3/S4  The two admission refusals: an empty batch, and a branch with no Tier-B attestation. (G1,G2)
# ================================================================================================
if want S3; then
  scenario S3 "an empty candidate list is FATAL, not a vacuous green"
  D="$TMPROOT/s3"; mkrepo "$D" f1:good; attest "$D" f1
  runq "$D" --branches ","
  eq "rc" "$RC" 2
  eq "gate invocations" "$RUNS" 0
  has "output" "$OUT" "candidate list is EMPTY"
fi

if want S4; then
  scenario S4 "a branch with no Tier-B attestation is refused, and an amended tip invalidates one"
  D="$TMPROOT/s4"; mkrepo "$D" f1:good f2:good; attest "$D" f1
  BEFORE="$(git -C "$D" rev-parse main)"
  runq "$D" --branches f1,f2
  eq "rc (f2 unattested, f1 alone proceeds)" "$RC" 0
  has "output" "$OUT" "f2:no-tier-b-attestation"
  hasnt "merged set" "$OUT" "merged           2"
  # The SHA binding: attest f2, then amend it. The stale attestation must not admit the new tip.
  attest "$D" f2
  git -C "$D" checkout -q f2 && printf 'amended\n' >> "$D/f2.txt" && git -C "$D" commit -qam amend && git -C "$D" checkout -q main
  runq "$D" --branches f2
  eq "rc after amend" "$RC" 2
  has "output" "$OUT" "no-tier-b-attestation"
fi

# ================================================================================================
# S5  THE HEADLINE: 8 branches, one bad. Bisect to it, merge the other 7, count the runs.
# ================================================================================================
if want S5; then
  scenario S5 "8 branches, 1 culprit: bisect, evict it, merge the other 7"
  D="$TMPROOT/s5"; mkrepo "$D" f1:good f2:good f3:good f4:good f5:bad f6:good f7:good f8:good
  attest "$D" f1 f2 f3 f4 f5 f6 f7 f8
  BEFORE="$(git -C "$D" rev-parse main)"
  runq "$D" --branches f1,f2,f3,f4,f5,f6,f7,f8
  AFTER="$(git -C "$D" rev-parse main)"
  eq "rc" "$RC" 1
  has "output" "$OUT" "CULPRIT f5 (independently red)"
  has "output" "$OUT" "merged           7"
  has "output" "$OUT" "evicted          1: f5"
  has "output" "$OUT" "REQUEUE:"
  # G6: the bisection NARROWED from 8 candidates to 1.
  has "output" "$OUT" "narrowed 8 -> 1"
  # The cost, asserted rather than claimed: batch(1) + bisect ceil(log2 8)=3 + confirm 1 + solo 1
  # + remainder 1 = 7 invocations. A change that makes this 8 is a linear scan in disguise.
  eq "gate invocations" "$RUNS" 7
  if [ "$BEFORE" != "$AFTER" ]; then ok "base MOVED despite the red batch (the 7 innocents landed)"; else bad "base did not move"; fi
  for b in f1 f2 f3 f4 f6 f7 f8; do
    if git -C "$D" merge-base --is-ancestor "$b" main; then ok "$b merged"; else bad "$b was NOT merged"; fi
  done
  if git -C "$D" merge-base --is-ancestor f5 main; then bad "f5 (the culprit) WAS merged"; else ok "f5 (the culprit) is NOT in main"; fi
fi

# ================================================================================================
# S6  TWO independently red branches in one batch. Both are found; the other 6 land.
# ================================================================================================
if want S6; then
  scenario S6 "8 branches, 2 independent culprits: both evicted, 6 merged"
  D="$TMPROOT/s6"; mkrepo "$D" f1:good f2:bad f3:good f4:good f5:good f6:bad f7:good f8:good
  attest "$D" f1 f2 f3 f4 f5 f6 f7 f8
  BEFORE="$(git -C "$D" rev-parse main)"
  runq "$D" --branches f1,f2,f3,f4,f5,f6,f7,f8
  eq "rc" "$RC" 1
  has "output" "$OUT" "CULPRIT f2 (independently red)"
  has "output" "$OUT" "CULPRIT f6 (independently red)"
  has "output" "$OUT" "merged           6"
  if git -C "$D" merge-base --is-ancestor f2 main || git -C "$D" merge-base --is-ancestor f6 main; then
    bad "a culprit was merged"; else ok "neither culprit is in main"; fi
  for b in f1 f3 f4 f5 f7 f8; do
    if git -C "$D" merge-base --is-ancestor "$b" main; then ok "$b merged"; else bad "$b was NOT merged"; fi
  done
  printf '    (cost: %s gate invocations for two culprits in 8)\n' "$RUNS"
  if [ "$RUNS" -ge 8 ] && [ "$RUNS" -le 16 ]; then ok "cost $RUNS runs is within the projected 2-culprit band (8-16)"; else bad "cost $RUNS runs is outside the projected band"; fi
  eq "base moved" "$([ "$(git -C "$D" rev-parse main)" != "$BEFORE" ] && echo yes || echo no)" yes
fi

# ================================================================================================
# S7  AN INTERACTION: two branches, each green alone, red together. Neither is "the bug".
# ================================================================================================
if want S7; then
  scenario S7 "interaction: f3 and f6 are green alone, red together"
  D="$TMPROOT/s7"; mkrepo "$D" f1:good f2:good f3:inta f4:good f5:good f6:intb f7:good f8:good
  attest "$D" f1 f2 f3 f4 f5 f6 f7 f8
  runq "$D" --branches f1,f2,f3,f4,f5,f6,f7,f8
  eq "rc" "$RC" 1
  has "output" "$OUT" "is GREEN alone but RED in P("
  has "output" "$OUT" "INTERACTION between f6 and f3"
  has "output" "$OUT" "interactions    f6+f3"
  has "output" "$OUT" "evicted          1: f6"
  has "output" "$OUT" "merged           7"
  if git -C "$D" merge-base --is-ancestor f3 main; then ok "f3 (the survivor of the pair) merged"; else bad "f3 not merged"; fi
  if git -C "$D" merge-base --is-ancestor f6 main; then bad "f6 merged"; else ok "f6 (last-in-loses) not merged"; fi
  printf '    (cost: %s gate invocations, including the partner search)\n' "$RUNS"
fi

# ================================================================================================
# S8  A FLAKE must not evict anyone. One intermittent red -> INCONCLUSIVE (rc 3), base unmoved.
# ================================================================================================
if want S8; then
  scenario S8 "a flaky gate yields INCONCLUSIVE, evicts nobody, merges nobody"
  D="$TMPROOT/s8"; mkrepo "$D" f1:good f2:good f3:good f4:good; attest "$D" f1 f2 f3 f4
  BEFORE="$(git -C "$D" rev-parse main)"
  FLAKE_AT=1 runq "$D" --branches f1,f2,f3,f4
  unset FLAKE_AT
  eq "rc" "$RC" 3
  has "output" "$OUT" "FLAKE DETECTED"
  has "output" "$OUT" "verdict          inconclusive"
  has "output" "$OUT" "evicted          0"
  has "output" "$OUT" "nothing merged, nobody blamed"
  eq "base unmoved" "$(git -C "$D" rev-parse main)" "$BEFORE"
  if [ "$RUNS" -gt 1 ]; then ok "the gate really ran ($RUNS invocations) before declaring inconclusive"; else bad "inconclusive after $RUNS run(s)"; fi
fi

# ================================================================================================
# S9  --verify-base: a base that is ALREADY red blames nobody.
# ================================================================================================
if want S9; then
  scenario S9 "--verify-base on a poisoned base: INCONCLUSIVE, no branch blamed"
  D="$TMPROOT/s9"; mkrepo "$D" f1:good f2:good
  git -C "$D" checkout -q main && printf 'boom\n' > "$D/bad-base.txt" && git -C "$D" add -A && git -C "$D" commit -qm poison
  # The branches predate the poison, so they merge cleanly and carry no bad file of their own.
  attest "$D" f1 f2
  BEFORE="$(git -C "$D" rev-parse main)"
  runq "$D" --branches f1,f2 --verify-base
  eq "rc" "$RC" 3
  has "output" "$OUT" "the BASE main is itself RED"
  has "output" "$OUT" "evicted          0"
  eq "base unmoved" "$(git -C "$D" rev-parse main)" "$BEFORE"
fi

# ================================================================================================
# S10 PUSH IS OFF BY DEFAULT, and needs three separate things to fire, proven against a SYNTHETIC
#     remote. Nothing here can reach a real forge: the remote is a bare repo in the temp dir.
# ================================================================================================
if want S10; then
  scenario S10 "push: off by default, refused without confirmation, works only on a synthetic remote"
  D="$TMPROOT/s10"; R="$TMPROOT/s10-remote.git"
  mkrepo "$D" f1:good f2:good; attest "$D" f1 f2
  git init -q --bare "$R"; git -C "$D" remote add origin "$R"
  git -C "$D" push -q origin main

  # (a) no --push at all: a green batch does not push.
  runq "$D" --branches f1
  eq "rc" "$RC" 0
  eq "pushed flag" "$(printf '%s\n' "$OUT" | awk '/pushed  /{print $2}')" 0
  REMOTE_AFTER_A="$(git -C "$R" rev-parse main)"
  if [ "$REMOTE_AFTER_A" != "$(git -C "$D" rev-parse main)" ]; then ok "the synthetic remote did NOT move without --push"; else bad "the remote moved without --push"; fi

  # (b) --push WITHOUT OO_MQ_PUSH_CONFIRM: prints the command, pushes nothing.
  runq "$D" --branches f2 --push
  eq "rc" "$RC" 0
  has "output" "$OUT" "PUSH SKIPPED"
  has "output" "$OUT" "OO_MQ_PUSH_CONFIRM is not 'yes'"
  if [ "$(git -C "$R" rev-parse main)" = "$REMOTE_AFTER_A" ]; then ok "the remote still did not move"; else bad "the remote moved without confirmation"; fi

  # (c) all three conditions: a synthetic non-forge remote, --push, and the confirmation.
  git -C "$D" checkout -q -b f3 main && printf 'f3\n' > "$D/f3.txt" && git -C "$D" add -A && git -C "$D" commit -qm f3 && git -C "$D" checkout -q main
  attest "$D" f3
  OUT="$( cd "$D" && GATE_TALLY="$D/.tally" OO_MQ_PUSH_CONFIRM=yes \
          bash "$MQ" --repo "$D" --gate "bash $D/gate.sh" --branches f3 --push 2>&1 )"; RC=$?
  eq "rc" "$RC" 0
  has "output" "$OUT" "PUSHED main -> origin"
  if [ "$(git -C "$R" rev-parse main)" = "$(git -C "$D" rev-parse main)" ]; then ok "the synthetic remote now matches local main"; else bad "the confirmed push did not land"; fi

  # (d) the forge guard: a remote whose URL looks like github.com is refused even with all of it.
  git -C "$D" remote set-url origin "https://github.com/example/not-real.git"
  git -C "$D" checkout -q -b f4 main && printf 'f4\n' > "$D/f4.txt" && git -C "$D" add -A && git -C "$D" commit -qm f4 && git -C "$D" checkout -q main
  attest "$D" f4
  OUT="$( cd "$D" && GATE_TALLY="$D/.tally" OO_MQ_PUSH_CONFIRM=yes \
          bash "$MQ" --repo "$D" --gate "bash $D/gate.sh" --branches f4 --push 2>&1 )"; RC=$?
  eq "rc" "$RC" 0
  has "output" "$OUT" "PUSH REFUSED"
  has "output" "$OUT" "which is a real forge"
fi

# ================================================================================================
# S11 The deadlock guard and the missing-gate guard: two ways to be fatal instead of vacuous.
# ================================================================================================
if want S11; then
  scenario S11 "--jobs>1 is refused (gui-lock deadlock); a missing gate is fatal, not green"
  D="$TMPROOT/s11"; mkrepo "$D" f1:good; attest "$D" f1
  runq "$D" --branches f1 --jobs 4
  eq "rc" "$RC" 2
  has "output" "$OUT" "gui-lock"
  eq "gate invocations" "$RUNS" 0
  OUT="$( cd "$D" && bash "$MQ" --repo "$D" --gate "tools/does-not-exist.sh" --branches f1 2>&1 )"; RC=$?
  eq "rc (missing gate)" "$RC" 2
  has "output" "$OUT" "does not exist in the tree"
fi

# ================================================================================================
# S12 A conflicting branch is evicted for FREE -- zero gate invocations spent on it.
# ================================================================================================
if want S12; then
  scenario S12 "a branch that does not merge cleanly is evicted at a cost of 0 gate runs"
  D="$TMPROOT/s12"; mkrepo "$D" f1:good f2:good
  git -C "$D" checkout -q -b c1 main && printf 'one\n' > "$D/clash.txt" && git -C "$D" add -A && git -C "$D" commit -qm c1
  git -C "$D" checkout -q -b c2 main && printf 'two\n' > "$D/clash.txt" && git -C "$D" add -A && git -C "$D" commit -qm c2
  git -C "$D" checkout -q main
  attest "$D" f1 f2 c1 c2
  runq "$D" --branches f1,c1,c2,f2
  eq "rc" "$RC" 0
  has "output" "$OUT" "does not merge cleanly onto main (cost: 0 gate runs)"
  eq "gate invocations" "$RUNS" 1
  has "output" "$OUT" "conflicted       1: c2"
  has "output" "$OUT" "merged           3"
fi

printf '\n================================================================\n'
# ANTI-VACUITY FOR THE SELFTEST ITSELF. `merge-queue-selftest S99` must not print GREEN having run
# nothing; and a scenario body that is skipped by a typo'd guard must not be able to hide.
if [ "$SELECTED_COUNT" -eq 0 ]; then
  printf 'merge-queue-selftest: FATAL -- the selection %s matched NO scenario; a selftest that ran nothing is not a pass\n' "'${WANT:-<all>}'" >&2
  exit 2
fi
if [ "$PASS" -eq 0 ]; then
  printf 'merge-queue-selftest: FATAL -- %d scenario(s) ran but ZERO assertions were made\n' "$SELECTED_COUNT" >&2
  exit 2
fi
printf 'merge-queue-selftest: %d scenario(s), %d assertion(s)\n' "$SELECTED_COUNT" "$((PASS+FAIL))"
if [ "$FAIL" -eq 0 ]; then
  printf 'merge-queue-selftest: GREEN -- %d assertion(s) passed, 0 failed\n' "$PASS"
  exit 0
fi
printf 'merge-queue-selftest: RED -- %d passed, %d FAILED (scenarios:%s)\n' "$PASS" "$FAIL" "$FAILED_NAMES" >&2
exit 1
