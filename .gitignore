build/
__pycache__/
*.pyc
.DS_Store
*.swp

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Per-bead git worktrees created by the beads-worker skill
.worktrees/

# Agent session scratch (scripts, logs); never commit
.agent-tmp/

# Golden harness run artifacts (tests/golden/run.sh); one directory per run
tests/golden/artifacts/

# orchestrator scratch: per-bead worker briefs and claimed-batch records (regenerated each turn)
.batch.jsonl
.fleet-briefs/
.ctx/
.beadinfo.json
tierb*.log

# bd run inside a worktree leaves this empty lock; never commit it (harvest would, and accept then cannot fast-forward)
.beads.gate.lock
